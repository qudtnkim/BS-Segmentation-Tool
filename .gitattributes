# Windows batch files MUST be CRLF. LF-only .bat can silently break parsing
# on Korean cp949 (and other CJK) consoles: `setlocal` gets read as `tlocal`,
# delayed expansion never activates, and every `!var!` blows up as an unknown command.
*.bat text eol=crlf

# PowerShell / cmd auxiliary scripts also want CRLF on Windows targets.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# POSIX shell scripts MUST be LF or bash on Linux/macOS trips on trailing CR.
*.sh text eol=lf

# Model weights are binary — never touch line endings on them.
*.pt binary
mobile_sam.pt binary
